---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
  class="text-muted mt-auto flex w-full flex-col items-center gap-3 pt-20 pb-4 text-center font-semibold sm:flex-row sm:justify-between sm:text-xs"
>
	<div class="max-w-full break-words sm:me-4">
		&copy; {siteConfig.author} {year} | <a class="hover:text-global-text hover:underline sm:py-0" href="https://github.com/chrismwilliams/astro-theme-cactus" target="_blank" rel="noopener noreferrer">Astro Cactus</a>
	</div>
	<nav
  aria-label="Footer"
  class="flex flex-wrap justify-center gap-x-2 gap-y-2 sm:divide-muted sm:gap-x-0 sm:divide-x"
>
		{
			menuLinks.map((link) => (
				<a class="hover:text-global-text px-4 py-2 hover:underline sm:py-0" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
