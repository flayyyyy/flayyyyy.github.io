<script>
	const scrollBtn = document.querySelector<HTMLButtonElement>("#to-top-btn");
const targetHeader = document.querySelector<HTMLElement>("#blog-hero");

if (scrollBtn && targetHeader) {
	// Back-to-top button code here
}

	const callback: IntersectionObserverCallback = (entries) => {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = String(!entry.isIntersecting);
		});
	};

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({
			behavior: "smooth",
			top: 0,
		});
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);

	// -------------------- TOC Scrollspy --------------------

	window.addEventListener("load", () => {
		const tocLinks = [
			...document.querySelectorAll<HTMLAnchorElement>(".toc a"),
		];

		const headings = tocLinks
			.map((link) => {
				const id = decodeURIComponent(link.hash.slice(1));
				return document.getElementById(id);
			})
			.filter((el): el is HTMLElement => el !== null);

		const tocObserver = new IntersectionObserver(
			(entries) => {
				const visible = entries.filter((e) => e.isIntersecting);

				if (!visible.length) return;

				const active = visible.sort(
					(a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
				)[0];

				if (!active) return;

				tocLinks.forEach((link) => {
					const isActive =
						decodeURIComponent(link.hash.slice(1)).normalize("NFC") ===
						active.target.id.normalize("NFC");

					link.classList.toggle("text-accent", isActive);
					link.classList.toggle("font-semibold", isActive);
					link.classList.toggle("border-s-2", isActive);
					link.classList.toggle("border-accent", isActive);
					link.classList.toggle("ps-2", isActive);
				});
			},
			{
				rootMargin: "0px 0px -65% 0px",
				threshold: 0,
			},
		);

		headings.forEach((h) => tocObserver.observe(h));
	});
</script>