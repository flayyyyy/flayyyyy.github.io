---
import Base from "@/layouts/Base.astro";
---

<Base meta={{ title: "Research" }}>
  <h1 class="mb-8">Research</h1>

  <!-- Hero -->
  <section class="hero">
    <div>
      <h2>Research Overview</h2>

      <p>
        My research lies at the intersection of condensed matter physics and
        quantum information science. I am interested in understanding quantum
        phenomena in superconducting systems and developing techniques that
        advance superconducting quantum technologies.
      </p>

      <p>
        I enjoy combining theoretical modelling, numerical simulations, and
        computational methods to investigate problems in superconductivity,
        quantum transport, and quantum materials. More recently, my work has
        expanded towards applying machine learning to superconducting quantum
        circuits and quantum control.
      </p>
    </div>

    <img
      src="/images/research/hero.jpg"
      alt="Superconducting quantum circuit"
    />
  </section>

  <!-- Research Interests -->
  <section class="section">
    <h2>Research Interests</h2>

    <div class="cards">
      <article class="card">
        <img src="/images/research/qubits.jpg" alt="" />

        <div class="content">
          <h3>Superconducting Quantum Circuits</h3>

          <p>
            Control, measurement, and optimization of superconducting qubits,
            with an emphasis on scalable quantum computing architectures.
          </p>
        </div>
      </article>

      <article class="card">
        <img src="/images/research/superconductivity.jpg" alt="" />

        <div class="content">
          <h3>Superconductivity</h3>

          <p>
            Josephson junctions, Andreev reflection, superconducting pairing,
            and transport in hybrid superconducting systems.
          </p>
        </div>
      </article>

      <article class="card">
        <img src="/images/research/kagome.jpg" alt="" />

        <div class="content">
          <h3>Quantum Materials</h3>

          <p>
            Emergent electronic phases, unconventional superconductivity,
            topology, and strongly correlated materials.
          </p>
        </div>
      </article>

      <article class="card">
        <img src="/images/research/computation.jpg" alt="" />

        <div class="content">
          <h3>Computational Physics</h3>

          <p>
            Numerical modelling, scientific machine learning, atomistic
            simulations, and computational approaches to condensed matter
            physics.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Current Directions -->
  <section class="two-column">
    <img
      src="/images/research/current.jpg"
      alt="Quantum device"
    />

    <div>
      <h2>Current Directions</h2>

      <p>
        My current research focuses on machine-learning assisted optimization
        of superconducting qubit control and readout, alongside the study of
        superconducting devices and quantum measurement techniques.
      </p>

      <p>
        More broadly, I am interested in connecting ideas from condensed matter
        physics with emerging quantum technologies, bridging theoretical models
        with experimentally relevant systems.
      </p>
    </div>
  </section>

  <!-- Methods -->
  <section class="section">
    <h2>Methods &amp; Tools</h2>

    <ul class="methods">
      <li>Bogoliubov–de Gennes formalism</li>
      <li>Quantum transport calculations</li>
      <li>Scientific machine learning</li>
      <li>Numerical simulations</li>
      <li>Python, PyTorch, QuTiP &amp; scqubits</li>
      <li>HFSS, ADS &amp; Microwave Office</li>
      <li>Device fabrication &amp; characterization</li>
    </ul>
  </section>
</Base>

<style>
.hero {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 3rem;
  align-items: center;
  margin-bottom: 5rem;
}

.hero img {
  width: 100%;
  border-radius: 12px;
  object-fit: cover;
}

.section {
  margin-top: 5rem;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.card {
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}

.card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.card .content {
  padding: 1rem;
}

.card h3 {
  margin-top: 0;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 3rem;
  align-items: center;
}

.two-column img {
  width: 100%;
  border-radius: 12px;
}

.methods {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 0.75rem 2rem;
  padding-left: 1.25rem;
}

@media (max-width: 900px) {
  .hero,
  .two-column {
    grid-template-columns: 1fr;
  }
}
</style>