---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import publications from "@/data/publications.json";
import Base from "@/layouts/Base.astro";

const sortedPublications = [...publications].sort(
	(a, b) =>
		new Date(b.issued["date-parts"]?.[0]?.join("-") ?? "1970-01-01").getTime() -
		new Date(a.issued["date-parts"]?.[0]?.join("-") ?? "1970-01-01").getTime(),
);

const projects = (await getCollection("post"))
	.filter((post) => post.data.tags?.includes("projects"))
	.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---

<Base meta={{ title: "Research" }}>
  <article class="prose">

    {
  projects.map((project) => (
        <section class="project">

          <h2 set:html={project.data.displayTitle ?? project.data.title}></h2>

          <p>{project.data.description}</p>

          {
  project.data.coverImage && (
    <Image
  src={project.data.coverImage.src}
  alt={project.data.coverImage.alt}
  layout="constrained"
/>
  )
}

          <p>
            <a href={`/posts/${project.id}`}>Read more →</a>
          </p>


        </section>
      ))
    }

    <h2>Publications/Preprints</h2>

    <ul>
  {
  sortedPublications.map((pub) => (
      <li>
        {pub.author.map(a => `${a.given} ${a.family}`).join(", ")}.
        <strong>{pub.title}</strong>.
        <em>{pub["container-title"]}</em>,
        {pub.issued["date-parts"]![0]![0]}.
      </li>
    ))
  }
</ul>

  </article>
</Base>

<style>
.prose {
  max-width: 760px;
  margin-top: -3rem;
}

.project {
  margin-bottom: 4rem;
}

img {
  margin: 2rem auto;
  border-radius: 8px;
}

hr {
  margin: 4rem 0;
}
</style>