import SocialList from "@/components/SocialList.astro";

const meta = {
	description: "PhD student, superconducting qubits.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I'm currently a research scholar and a PhD candidate in the <a href="https://www.tifr.res.in/dcmpms/" target="_blank" rel="noopener noreferrer">Department of Condensed Matter Physics & Materials Science (DCMPMS)</a> at the <a href="https://main.tifr.res.in/" target="_blank" rel="noopener noreferrer">Tata Institute of Fundamental Research (TIFR)</a>, Mumbai, working on optimizing control and readout signals of superconducting qubits using machine learning. On a bigger scale, my aim is to contribute towards building fault-tolerant quantum computers. I graduated from the <a href="https://iitr.ac.in/" target="_blank" rel="noopener noreferrer">Indian Institute of Technology Roorkee</a> with an Integrated Master of Science in Physics. My past research interests have been in studying condensed matter systems that host novel states of matter and using atomistic simulations to calculate material properties.
		</p>
		<SocialList />
	</div>
</PageLayout>
